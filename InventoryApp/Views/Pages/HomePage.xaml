<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryApp.Views.Pages.HomePage"
             Title="">

    <RefreshView x:Name="Refresh" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label Style="{StaticResource Headline}"
                       FontSize="28"
                       HorizontalTextAlignment="Start"
                       HorizontalOptions="Start">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Семейный " />
                            <Span Text="инвентарь" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="Добавить предмет"
                            Clicked="OnAddItemClicked"
                            SemanticProperties.Description="Открыть форму нового предмета" />
                    <Button Grid.Column="1"
                            Text="Все предметы"
                            Clicked="OnBrowseItemsClicked"
                            SemanticProperties.Description="Каталог и поиск предметов" />
                </Grid>

                <Label Text="Сводка"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource AppText}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0"
                            Stroke="{StaticResource Gray600}" StrokeThickness="1"
                            BackgroundColor="{StaticResource AppCard}" Padding="14"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label x:Name="ItemsCountLabel" Text="—" FontSize="28" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                            <Label Text="Вещей" FontSize="13" TextColor="{StaticResource AppMuted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1"
                            Stroke="{StaticResource Gray600}" StrokeThickness="1"
                            BackgroundColor="{StaticResource AppCard}" Padding="14"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label x:Name="RoomsCountLabel" Text="—" FontSize="28" FontAttributes="Bold"
                                   TextColor="{StaticResource AppSuccess}" HorizontalTextAlignment="Center" />
                            <Label Text="Комнат" FontSize="13" TextColor="{StaticResource AppMuted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0"
                            Stroke="{StaticResource Gray600}" StrokeThickness="1"
                            BackgroundColor="{StaticResource AppCard}" Padding="14"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label x:Name="CategoriesCountLabel" Text="—" FontSize="28" FontAttributes="Bold"
                                   TextColor="{StaticResource AppInfo}" HorizontalTextAlignment="Center" />
                            <Label Text="Категорий" FontSize="13" TextColor="{StaticResource AppMuted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1"
                            Stroke="{StaticResource Gray600}" StrokeThickness="1"
                            BackgroundColor="{StaticResource AppCard}" Padding="14"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label x:Name="UsersCountLabel" Text="—" FontSize="28" FontAttributes="Bold"
                                   TextColor="{StaticResource AppWarning}" HorizontalTextAlignment="Center" />
                            <Label Text="Пользователей" FontSize="13" TextColor="{StaticResource AppMuted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0"
                            Stroke="{StaticResource Gray600}" StrokeThickness="1"
                            BackgroundColor="{StaticResource AppCard}" Padding="14"
                            StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExpiringSoonTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label x:Name="ExpiringSoonLabel" Text="—" FontSize="28" FontAttributes="Bold"
                                   TextColor="{StaticResource AppWarning}" HorizontalTextAlignment="Center" />
                            <Label Text="Срок ≤ 30 дней" FontSize="13" TextColor="{StaticResource AppMuted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1"
                            Stroke="{StaticResource Gray600}" StrokeThickness="1"
                            BackgroundColor="{StaticResource AppCard}" Padding="14"
                            StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExpiredTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label x:Name="ExpiredLabel" Text="—" FontSize="28" FontAttributes="Bold"
                                   TextColor="{StaticResource AppDanger}" HorizontalTextAlignment="Center" />
                            <Label Text="Просрочено" FontSize="13" TextColor="{StaticResource AppMuted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <ActivityIndicator x:Name="Loading" IsRunning="True" IsVisible="True" Color="{StaticResource Primary}" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
